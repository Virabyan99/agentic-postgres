{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Virabyan99/agentic-postgres/schemas/outputs.schema.json",
  "title": "Agentic Postgres generated outputs",
  "description": "The automation contract. additionalProperties is false at every level so a new field cannot appear unreviewed, and there is deliberately no timestamp anywhere: identical inputs must render byte-identically.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inputs",
    "project",
    "compose",
    "database",
    "routes",
    "jwt",
    "secrets",
    "storage",
    "backup",
    "capabilities",
    "template_version"
  ],
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_sha256",
        "capabilities_sha256",
        "versions_lock_sha256",
        "source_specification_sha256"
      ],
      "description": "Every file that determines this render. The same block appears in each generated file, so an incomplete set is detectable.",
      "properties": {
        "project_sha256": { "$ref": "#/$defs/sha256" },
        "capabilities_sha256": { "$ref": "#/$defs/sha256" },
        "versions_lock_sha256": { "$ref": "#/$defs/sha256" },
        "source_specification_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "environment", "key", "domain", "generated_directory"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,30}$" },
        "environment": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,15}$" },
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]{4,47}$" },
        "domain": { "type": "string", "format": "hostname" },
        "generated_directory": { "type": "string", "pattern": "^\\.generated/[a-z0-9-]+$" }
      }
    },
    "compose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_name", "networks", "volumes"],
      "properties": {
        "project_name": { "$ref": "#/$defs/composeName" },
        "networks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["edge", "internal"],
          "properties": {
            "edge": { "$ref": "#/$defs/composeName" },
            "internal": { "$ref": "#/$defs/composeName" }
          }
        },
        "volumes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["postgres"],
          "properties": { "postgres": { "$ref": "#/$defs/composeName" } }
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "roles", "pooled", "direct"],
      "properties": {
        "name": { "$ref": "#/$defs/postgresIdentifier" },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "anon",
            "authenticated",
            "agent_reader",
            "agent_writer",
            "project_admin",
            "postgrest_authenticator",
            "auth_service",
            "mcp_audit_service",
            "storage_service",
            "migration_user",
            "backup_user",
            "app_runtime",
            "object_owner"
          ],
          "properties": {
            "anon": { "$ref": "#/$defs/postgresIdentifier" },
            "authenticated": { "$ref": "#/$defs/postgresIdentifier" },
            "agent_reader": { "$ref": "#/$defs/postgresIdentifier" },
            "agent_writer": { "$ref": "#/$defs/postgresIdentifier" },
            "project_admin": { "$ref": "#/$defs/postgresIdentifier" },
            "postgrest_authenticator": { "$ref": "#/$defs/postgresIdentifier" },
            "auth_service": { "$ref": "#/$defs/postgresIdentifier" },
            "mcp_audit_service": { "$ref": "#/$defs/postgresIdentifier" },
            "storage_service": { "$ref": "#/$defs/postgresIdentifier" },
            "migration_user": { "$ref": "#/$defs/postgresIdentifier" },
            "backup_user": { "$ref": "#/$defs/postgresIdentifier" },
            "app_runtime": { "$ref": "#/$defs/postgresIdentifier" },
            "object_owner": { "$ref": "#/$defs/postgresIdentifier" }
          }
        },
        "pooled": { "$ref": "#/$defs/endpoint" },
        "direct": { "$ref": "#/$defs/endpoint" }
      }
    },
    "routes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rest", "app", "mcp", "docs"],
      "properties": {
        "rest": { "$ref": "#/$defs/httpsUrl" },
        "app": { "$ref": "#/$defs/httpsUrl" },
        "mcp": { "$ref": "#/$defs/httpsUrl" },
        "docs": { "$ref": "#/$defs/httpsUrl" }
      }
    },
    "jwt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "audience"],
      "properties": {
        "issuer": { "$ref": "#/$defs/httpsUrl" },
        "audience": { "type": "string", "pattern": "^urn:agentic-postgres:[a-z0-9-]+:[a-z0-9-]+$" }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace"],
      "description": "A namespace reference only. No secret value ever appears here.",
      "properties": {
        "namespace": { "type": "string", "pattern": "^agentic-postgres/[a-z0-9-]+$" }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "bucket", "prefix"],
      "properties": {
        "enabled": { "type": "boolean" },
        "bucket": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$"
        },
        "prefix": { "type": ["string", "null"], "pattern": "^[^/].*/$" }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "stanza", "repository_prefix"],
      "properties": {
        "enabled": { "type": "boolean" },
        "stanza": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$" },
        "repository_prefix": { "type": ["string", "null"], "pattern": "^[^/].*/$" }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,47}$" }
        }
      }
    },
    "template_version": { "type": "string", "minLength": 1, "maxLength": 64 }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Lowercase hexadecimal. Documentation placeholders are not accepted."
    },
    "postgresIdentifier": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*$",
      "maxLength": 63
    },
    "composeName": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "maxLength": 63
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://[a-z0-9.-]+(/[A-Za-z0-9._~/-]*)?$",
      "description": "No userinfo component, so a credential cannot be smuggled into a URL."
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "available_from_session", "host", "port", "url", "password_secret_ref"],
      "description": "Session 1 knows no tunnel host, bound port, or credential, so every field is null with an explicit unavailable status. Angle-bracket placeholders that resemble connection strings are not permitted.",
      "properties": {
        "status": { "type": "string", "enum": ["unavailable", "available"] },
        "available_from_session": { "type": "integer", "minimum": 1, "maximum": 12 },
        "host": { "type": ["string", "null"] },
        "port": { "type": ["integer", "null"], "minimum": 1, "maximum": 65535 },
        "url": { "type": ["string", "null"] },
        "password_secret_ref": { "type": ["string", "null"] }
      },
      "if": {
        "properties": { "status": { "const": "unavailable" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "host": { "type": "null" },
          "port": { "type": "null" },
          "url": { "type": "null" },
          "password_secret_ref": { "type": "null" }
        }
      }
    }
  }
}
