{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Virabyan99/agentic-postgres/schemas/outputs.schema.json",
  "title": "Agentic Postgres generated outputs",
  "description": "The automation contract, version 4. One versioned schema, two document kinds, discriminated by a required `document_kind` const and separated by a oneOf so a rendered document can never validate as deployed state. `rendered` is a pure function of the digested inputs and contains no timestamp, no observed value and no provider identifier. `deployed` is a published observation of a converged host and contains all three. additionalProperties is false at every level of both branches. Version 3 added the Session 3 database block -- container identity, memory budget, and observed cluster facts -- and split the formerly shared `database` definition in two so that `observed` is unrepresentable on the rendered branch. Version 4 added `database.access_profiles`, three ways to reach the two transports (ADR 0041), and closed the endpoint conditional so that an `available` endpoint must actually carry a host, a port, a password-free URL and a secret reference. See docs/decisions/0012-output-document-kinds.md, docs/decisions/0027-the-output-schema-gains-a-version-and-a-migration-path.md and docs/decisions/0041-two-transports-three-access-profiles.md.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/renderedDocument" },
    { "$ref": "#/$defs/deployedDocument" }
  ],

  "$defs": {
    "renderedDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "document_kind",
        "inputs",
        "project",
        "compose",
        "database",
        "routes",
        "jwt",
        "secrets",
        "storage",
        "backup",
        "capabilities",
        "template_version"
      ],
      "properties": {
        "schema_version": { "type": "integer", "enum": [4] },
        "document_kind": { "const": "rendered" },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "project_sha256",
            "capabilities_sha256",
            "secrets_contract_sha256",
            "versions_lock_sha256",
            "source_specification_sha256"
          ],
          "description": "Every file that determines this render. The same block appears in each generated file, so an incomplete set is detectable. secrets_contract_sha256 joined the set in Session 2 when secrets.required_names started reaching rendered output: a value derived from a file that is not digested here would make the render depend on an untracked input.",
          "properties": {
            "project_sha256": { "$ref": "#/$defs/sha256" },
            "capabilities_sha256": { "$ref": "#/$defs/sha256" },
            "secrets_contract_sha256": { "$ref": "#/$defs/sha256" },
            "versions_lock_sha256": { "$ref": "#/$defs/sha256" },
            "source_specification_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "project": {
          "type": "object",
          "additionalProperties": false,
          "required": ["slug", "environment", "key", "domain", "generated_directory"],
          "properties": {
            "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,30}$" },
            "environment": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,15}$" },
            "key": { "$ref": "#/$defs/projectKey" },
            "domain": { "type": "string", "format": "hostname" },
            "generated_directory": {
              "type": "string",
              "pattern": "^\\.generated/[a-z0-9-]+$",
              "description": "Repository-relative, and deliberately still so in v2. Host paths live on the deployed branch under `runtime`, with their own anchored absolute patterns; loosening this one to carry both meanings is how a path-traversal check dies."
            }
          }
        },
        "compose": {
          "type": "object",
          "additionalProperties": false,
          "required": ["project_name", "networks", "volumes"],
          "properties": {
            "project_name": { "$ref": "#/$defs/composeName" },
            "networks": {
              "type": "object",
              "additionalProperties": false,
              "required": ["edge", "internal"],
              "properties": {
                "edge": { "$ref": "#/$defs/composeName" },
                "internal": { "$ref": "#/$defs/composeName" }
              }
            },
            "volumes": {
              "type": "object",
              "additionalProperties": false,
              "required": ["postgres"],
              "properties": { "postgres": { "$ref": "#/$defs/composeName" } }
            }
          }
        },
        "database": { "$ref": "#/$defs/renderedDatabase" },
        "routes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rest", "app", "mcp", "docs", "health"],
          "properties": {
            "rest": { "$ref": "#/$defs/httpsUrl" },
            "app": { "$ref": "#/$defs/httpsUrl" },
            "mcp": { "$ref": "#/$defs/httpsUrl" },
            "docs": { "$ref": "#/$defs/httpsUrl" },
            "health": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "url"],
              "description": "An object rather than a bare URL so the rendered and deployed branches stay structurally parallel: the deployed document has to carry a readiness claim, and a claim needs somewhere to live.",
              "properties": {
                "status": { "const": "planned" },
                "url": { "$ref": "#/$defs/httpsUrl" }
              }
            }
          }
        },
        "jwt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["issuer", "audience"],
          "properties": {
            "issuer": { "$ref": "#/$defs/httpsUrl" },
            "audience": {
              "type": "string",
              "pattern": "^urn:agentic-postgres:[a-z0-9-]+:[a-z0-9-]+$"
            }
          }
        },
        "secrets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["namespace", "status", "required_names"],
          "description": "Names only. No value, no reference to a materialized path, no generation identifier -- a rendered document describes a plan, and nothing has been materialized when it is written.",
          "properties": {
            "namespace": { "type": "string", "pattern": "^agentic-postgres/[a-z0-9-]+$" },
            "status": { "const": "planned" },
            "required_names": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,47}$" }
            }
          }
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "bucket", "prefix"],
          "properties": {
            "enabled": { "type": "boolean" },
            "bucket": {
              "type": ["string", "null"],
              "pattern": "^[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$"
            },
            "prefix": { "type": ["string", "null"], "pattern": "^[^/].*/$" }
          }
        },
        "backup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "stanza", "repository_prefix"],
          "properties": {
            "enabled": { "type": "boolean" },
            "stanza": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$" },
            "repository_prefix": { "type": ["string", "null"], "pattern": "^[^/].*/$" }
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,47}$" }
            }
          }
        },
        "template_version": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },

    "deployedDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "document_kind",
        "source_commit",
        "deployed_through_session",
        "project",
        "host",
        "edge",
        "routes",
        "tls",
        "bootstrap",
        "secrets",
        "runtime",
        "database",
        "template_version",
        "observed_at"
      ],
      "description": "Root-owned, mode 0600, written under /etc/agentic-postgres/projects/{project_key}/ only after successful convergence. It is a published observation, not the authority for provider ownership -- that is bootstrap-state.json. It carries provider IDs and client IDs; it never carries a client secret, an access token, a sentinel value, a secret checksum or a credential-bearing URL.",
      "properties": {
        "schema_version": { "type": "integer", "enum": [4] },
        "document_kind": { "const": "deployed" },
        "source_commit": { "$ref": "#/$defs/commit" },
        "deployed_through_session": {
          "type": "integer",
          "minimum": 2,
          "description": "The session this project was deployed through. Read back by the systemd launcher at boot to choose the secret set and the Compose profiles, so that a restart brings up what the deploy brought up rather than a subset of it. Absent from the rendered branch by construction: a render deploys nothing. Minimum 2 because sessions before that start no container at all."
        },
        "project": {
          "type": "object",
          "additionalProperties": false,
          "required": ["slug", "environment", "key", "domain"],
          "properties": {
            "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,30}$" },
            "environment": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,15}$" },
            "key": { "$ref": "#/$defs/projectKey" },
            "domain": { "type": "string", "format": "hostname" }
          }
        },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "os_release", "public_ipv4", "public_ipv6"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,30}[a-z0-9]$" },
            "os_release": { "type": "string", "enum": ["26.04", "24.04"] },
            "public_ipv4": { "type": ["string", "null"], "format": "ipv4" },
            "public_ipv6": { "type": ["string", "null"], "format": "ipv6" }
          }
        },
        "edge": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stack_name",
            "control_network",
            "egress_network",
            "project_edge_network",
            "project_internal_network",
            "project_network_attached"
          ],
          "properties": {
            "stack_name": { "$ref": "#/$defs/composeName" },
            "control_network": { "$ref": "#/$defs/composeName" },
            "egress_network": { "$ref": "#/$defs/composeName" },
            "project_edge_network": { "$ref": "#/$defs/composeName" },
            "project_internal_network": { "$ref": "#/$defs/composeName" },
            "project_network_attached": { "type": "boolean" }
          }
        },
        "routes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["health"],
          "properties": {
            "health": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "url"],
              "properties": {
                "status": { "type": "string", "enum": ["ready", "unavailable"] },
                "url": { "$ref": "#/$defs/httpsUrl" }
              }
            }
          }
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "acme_environment",
            "resolver",
            "certificate_sha256",
            "not_before",
            "not_after"
          ],
          "properties": {
            "status": { "type": "string", "enum": ["issued", "unavailable"] },
            "acme_environment": { "type": "string", "enum": ["staging", "production"] },
            "resolver": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$" },
            "certificate_sha256": {
              "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }],
              "description": "A fingerprint of a public certificate. Public material, so recording it leaks nothing; it is what lets the external suite prove it reached the same certificate the host issued."
            },
            "not_before": { "$ref": "#/$defs/nullableTimestamp" },
            "not_after": { "$ref": "#/$defs/nullableTimestamp" }
          }
        },
        "bootstrap": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "state_path",
            "infisical_project_id",
            "runtime_identity_id"
          ],
          "properties": {
            "status": { "type": "string", "enum": ["complete", "unavailable"] },
            "state_path": {
              "type": "string",
              "pattern": "^/etc/agentic-postgres/projects/[a-z0-9-]+/bootstrap-state\\.json$"
            },
            "infisical_project_id": { "$ref": "#/$defs/providerId" },
            "runtime_identity_id": { "$ref": "#/$defs/providerId" }
          }
        },
        "secrets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "generation_id",
            "generation_manifest",
            "required_names",
            "fresh",
            "materialized_at"
          ],
          "properties": {
            "status": { "type": "string", "enum": ["ready", "unavailable"] },
            "generation_id": { "$ref": "#/$defs/generationId" },
            "generation_manifest": {
              "type": "string",
              "pattern": "^/var/lib/agentic-postgres/secrets/[a-z0-9-]+/generations/[a-z0-9-]+/manifest\\.json$"
            },
            "required_names": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,47}$" }
            },
            "fresh": {
              "type": "boolean",
              "description": "False records a bounded last-known-good start. Recorded rather than hidden: a host that has been running on a stale generation is a fact an operator needs."
            },
            "materialized_at": { "$ref": "#/$defs/nullableTimestamp" }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["release_path", "state_directory", "compose_model_sha256"],
          "description": "Absolute host paths, anchored. This is where Session 2's filesystem layout is represented, so project.generated_directory never has to stop being repository-relative.",
          "properties": {
            "release_path": {
              "type": "string",
              "pattern": "^/opt/agentic-postgres/releases/[0-9a-f]{40}$"
            },
            "state_directory": {
              "type": "string",
              "pattern": "^/etc/agentic-postgres/projects/[a-z0-9-]+$"
            },
            "compose_model_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "database": { "$ref": "#/$defs/deployedDatabase" },
        "template_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "observed_at": { "$ref": "#/$defs/timestamp" }
      }
    },

    "renderedDatabase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "container", "roles", "budget", "pooled", "direct", "access_profiles"],
      "description": "Version 4. The rendered branch carries no `observed` block at all -- not an empty one, not a nulled one. ADR 0012 says a rendered document contains no observed value, and the cheapest way to keep that true is for the field to be unrepresentable here rather than merely constrained. That is why the two branches have separate definitions instead of one shared one. Version 4 added `access_profiles` (ADR 0041).",
      "properties": {
        "name": { "$ref": "#/$defs/postgresIdentifier" },
        "container": { "$ref": "#/$defs/composeName" },
        "roles": { "$ref": "#/$defs/databaseRoles" },
        "budget": { "$ref": "#/$defs/databaseBudget" },
        "pooled": { "$ref": "#/$defs/endpoint" },
        "direct": { "$ref": "#/$defs/endpoint" },
        "access_profiles": { "$ref": "#/$defs/accessProfiles" }
      }
    },

    "deployedDatabase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "container",
        "roles",
        "budget",
        "pooled",
        "direct",
        "access_profiles",
        "observed"
      ],
      "description": "Version 4. Identical to the rendered branch plus `observed`, which is the only block here that is a measurement rather than a derivation.",
      "properties": {
        "name": { "$ref": "#/$defs/postgresIdentifier" },
        "container": { "$ref": "#/$defs/composeName" },
        "roles": { "$ref": "#/$defs/databaseRoles" },
        "budget": { "$ref": "#/$defs/databaseBudget" },
        "pooled": { "$ref": "#/$defs/endpoint" },
        "direct": { "$ref": "#/$defs/endpoint" },
        "access_profiles": { "$ref": "#/$defs/accessProfiles" },
        "observed": { "$ref": "#/$defs/databaseObserved" }
      }
    },

    "databaseRoles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anon",
        "authenticated",
        "agent_reader",
        "agent_writer",
        "project_admin",
        "postgrest_authenticator",
        "auth_service",
        "mcp_audit_service",
        "storage_service",
        "migration_user",
        "backup_user",
        "app_runtime",
        "object_owner"
      ],
      "properties": {
        "anon": { "$ref": "#/$defs/postgresIdentifier" },
        "authenticated": { "$ref": "#/$defs/postgresIdentifier" },
        "agent_reader": { "$ref": "#/$defs/postgresIdentifier" },
        "agent_writer": { "$ref": "#/$defs/postgresIdentifier" },
        "project_admin": { "$ref": "#/$defs/postgresIdentifier" },
        "postgrest_authenticator": { "$ref": "#/$defs/postgresIdentifier" },
        "auth_service": { "$ref": "#/$defs/postgresIdentifier" },
        "mcp_audit_service": { "$ref": "#/$defs/postgresIdentifier" },
        "storage_service": { "$ref": "#/$defs/postgresIdentifier" },
        "migration_user": { "$ref": "#/$defs/postgresIdentifier" },
        "backup_user": { "$ref": "#/$defs/postgresIdentifier" },
        "app_runtime": { "$ref": "#/$defs/postgresIdentifier" },
        "object_owner": { "$ref": "#/$defs/postgresIdentifier" }
      }
    },

    "databaseBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shared_buffers_mb",
        "max_connections",
        "work_mem_mb",
        "maintenance_work_mem_mb",
        "memory_limit_mb",
        "shm_size_mb",
        "unreclaimable_mb"
      ],
      "description": "Derived from the manifest, so it belongs on the rendered branch. `unreclaimable_mb` is the only computed member: it is what the host must actually find, because on a box with no swap page cache is reclaimable and shared memory is not. It is deliberately NOT equal to memory_limit_mb -- see the Session 3 plan 3.3 for the measurement that separated them.",
      "properties": {
        "shared_buffers_mb": { "type": "integer", "minimum": 16, "maximum": 1024 },
        "max_connections": { "type": "integer", "minimum": 10, "maximum": 200 },
        "work_mem_mb": { "type": "integer", "minimum": 1, "maximum": 64 },
        "maintenance_work_mem_mb": { "type": "integer", "minimum": 16, "maximum": 512 },
        "memory_limit_mb": { "type": "integer", "minimum": 128, "maximum": 4096 },
        "shm_size_mb": { "type": "integer", "minimum": 64, "maximum": 1024 },
        "unreclaimable_mb": { "type": "integer", "minimum": 1, "maximum": 4096 }
      }
    },

    "databaseObserved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "server_version", "extensions", "memory"],
      "description": "Measured against a running cluster, never derived. `not_observed` with four nulls is the honest state for a deployment that has not yet been read -- the same discipline `endpoint` uses, for the same reason: a zero or an empty object would be indistinguishable from a real measurement that happened to be empty.",
      "properties": {
        "status": { "type": "string", "enum": ["observed", "not_observed"] },
        "server_version": {
          "type": ["string", "null"],
          "pattern": "^[0-9]+(\\.[0-9]+)*",
          "maxLength": 64
        },
        "extensions": {
          "type": ["object", "null"],
          "additionalProperties": { "type": "string", "maxLength": 32 },
          "propertyNames": { "$ref": "#/$defs/postgresIdentifier" },
          "description": "Installed extension name to installed version, read from pg_extension. Not pg_available_extensions: what is available is not what is installed, and the distinction is the whole content of DBX-PG-001."
        },
        "memory": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["anon_mb", "shmem_mb", "file_mb"],
              "description": "The three kept separate on purpose. A single `memory_mb` would average a reclaimable number together with an unreclaimable one and report something that is true of neither.",
              "properties": {
                "anon_mb": { "type": "integer", "minimum": 0 },
                "shmem_mb": { "type": "integer", "minimum": 0 },
                "file_mb": { "type": "integer", "minimum": 0 }
              }
            },
            { "type": "null" }
          ]
        }
      },
      "if": {
        "properties": { "status": { "const": "not_observed" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "server_version": { "type": "null" },
          "extensions": { "type": "null" },
          "memory": { "type": "null" }
        }
      }
    },

    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Lowercase hexadecimal. Documentation placeholders are not accepted."
    },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "projectKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]{4,47}$" },
    "generationId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "providerId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{1,127}$",
      "description": "A provider resource identifier or a non-secret client ID. Client secrets are excluded from this document entirely, not merely pattern-constrained."
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "RFC 3339 UTC. Present only on the deployed branch: the rendered branch is byte-identical across renders and a timestamp would destroy that (plan decision U, extended by ADR 0012)."
    },
    "nullableTimestamp": {
      "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
    },
    "postgresIdentifier": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*$",
      "maxLength": 63
    },
    "composeName": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "maxLength": 63
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://[a-z0-9.-]+(/[A-Za-z0-9._~/-]*)?$",
      "description": "No userinfo component, so a credential cannot be smuggled into a URL."
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "available_from_session",
        "host",
        "port",
        "url",
        "password_secret_ref"
      ],
      "description": "Version 4 made the available case as constrained as the unavailable one. Through version 3 the conditional bound only `unavailable`, so a document could claim `available` with every field still null and validate -- an endpoint that says it exists and tells you nothing. Angle-bracket placeholders that resemble connection strings are not permitted, and the URL may not carry a password: `postgresql://role@host:port/db` is the shape, and a `role:secret@` userinfo fails the pattern rather than being redacted later by something that might forget.",
      "properties": {
        "status": { "type": "string", "enum": ["unavailable", "available"] },
        "available_from_session": { "type": "integer", "minimum": 1, "maximum": 12 },
        "host": { "type": ["string", "null"] },
        "port": { "type": ["integer", "null"], "minimum": 1, "maximum": 65535 },
        "url": { "type": ["string", "null"] },
        "password_secret_ref": { "type": ["string", "null"] }
      },
      "if": {
        "properties": { "status": { "const": "unavailable" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "host": { "type": "null" },
          "port": { "type": "null" },
          "url": { "type": "null" },
          "password_secret_ref": { "type": "null" }
        }
      },
      "else": {
        "properties": {
          "host": { "type": "string", "minLength": 1 },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "url": { "$ref": "#/$defs/postgresUrl" },
          "password_secret_ref": { "type": "string", "minLength": 1 }
        }
      }
    },

    "postgresUrl": {
      "type": "string",
      "pattern": "^postgresql://[a-z_][a-z0-9_]*@[a-z0-9.-]+:[0-9]{1,5}/[a-z_][a-z0-9_]*(\\?[A-Za-z0-9._~=&%-]+)?$",
      "maxLength": 512,
      "description": "A role and a host, never a password. The userinfo component admits one identifier and no colon, so `postgresql://role:secret@host/db` cannot validate. This is the same rule `httpsUrl` states for the public surfaces, applied where it matters most."
    },

    "accessProfiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_pooled", "runtime_direct", "migration_direct"],
      "description": "Version 4, ADR 0041. Three ways to reach two transports. The endpoints say *where*; these say *as whom*, so a reader can answer 'what may this credential do' without consulting the code. Each profile's transport is fixed by a const here rather than merely typed, because a profile named `runtime_pooled` that pointed at the direct transport would be a document that validates and lies.",
      "properties": {
        "runtime_pooled": {
          "allOf": [
            { "$ref": "#/$defs/accessProfile" },
            { "properties": { "transport": { "const": "pooled" } } }
          ]
        },
        "runtime_direct": {
          "allOf": [
            { "$ref": "#/$defs/accessProfile" },
            { "properties": { "transport": { "const": "direct" } } }
          ]
        },
        "migration_direct": {
          "allOf": [
            { "$ref": "#/$defs/accessProfile" },
            { "properties": { "transport": { "const": "direct" } } }
          ]
        }
      }
    },

    "accessProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "available_from_session", "transport", "role", "password_secret_ref"],
      "description": "`transport` and `role` are derivations and are present from the first render: the transport is fixed by the profile's name and the role comes from `naming`, so nulling them while unavailable would hide a fact the document already knows. `password_secret_ref` is the one member that waits, because a secret reference names something that must have been declared.",
      "properties": {
        "status": { "type": "string", "enum": ["unavailable", "available"] },
        "available_from_session": { "type": "integer", "minimum": 1, "maximum": 12 },
        "transport": { "type": "string", "enum": ["pooled", "direct"] },
        "role": { "$ref": "#/$defs/postgresIdentifier" },
        "password_secret_ref": { "type": ["string", "null"] }
      },
      "if": {
        "properties": { "status": { "const": "unavailable" } },
        "required": ["status"]
      },
      "then": {
        "properties": { "password_secret_ref": { "type": "null" } }
      },
      "else": {
        "properties": { "password_secret_ref": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
