# /etc/secret-store/backup.env -- root, 0600. Read only by the rclone container
# backup.sh starts. The key is a Backblaze B2 application key restricted to the
# bucket apg-secret-store-backup (made by the operator at the console, ADR 0110).
RCLONE_CONFIG_STORE_TYPE=b2
RCLONE_CONFIG_STORE_ACCOUNT=
RCLONE_CONFIG_STORE_KEY=
