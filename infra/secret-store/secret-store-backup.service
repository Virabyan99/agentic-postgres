[Unit]
Description=The secret store's encrypted backup to B2 (ADR 0262)
Documentation=https://github.com/Virabyan99/agentic-postgres/blob/main/docs/secret-store.md
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/secret-store-backup
TimeoutStartSec=1800
