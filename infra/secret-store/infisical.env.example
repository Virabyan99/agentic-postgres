# /etc/secret-store/infisical.env -- root, 0600. The backend's ONLY env file.
# Each value is generated on the store host at the operator's terminal and
# written to the operator's password manager BEFORE the stack first starts
# (docs/secret-store.md §2, ADR 0262). Never committed, never pasted anywhere.
#
#   ENCRYPTION_KEY     openssl rand -hex 16       (lost = every secret unreadable)
#   AUTH_SECRET        openssl rand -base64 32
#   DB_CONNECTION_URI  postgres://infisical:<db.env's POSTGRES_PASSWORD>@db:5432/infisical
ENCRYPTION_KEY=
AUTH_SECRET=
DB_CONNECTION_URI=
