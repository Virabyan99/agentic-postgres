#!/usr/bin/env bash
#
# Stable root-owned trampoline for one project.
# Installed at /usr/local/libexec/agentic-postgres/project.
#
# Invoked by agentic-postgres-project@.service, whose instance name (%i) is the
# project key. That key arrives through a *filename*, so it is operator input
# even though it looks like configuration: `systemctl start
# agentic-postgres-project@../../etc` is a question this script has to have an
# answer to. The answer is that %i is validated against the project-key pattern
# before it is used, and every path is derived from it rather than accepted.
#
# THIS FILE RESOLVES A RELEASE AND NOTHING ELSE (ADR 0037).
#
# It is installed by `bin/provision-host.sh` at provisioning time and refreshed
# by every deploy, and one copy serves every project on the host -- including
# projects deployed through different releases. So anything it knows, it knows on
# behalf of releases it has never seen. It used to know which session to
# materialize and which script each action runs; both are properties of a
# release, and the copy sitting on the host was written before Session 3 existed.
# It ran `--session 2` against a Session 3 project, wrote a secret generation
# holding Session 2's secret set, repointed the project at it, and only then
# failed (D72).
#
# What is left here is the part that cannot come from a release, because it is
# what finds the release: validate the instance name, read the deployed
# document, and hand over to that release's own launcher. Everything else lives
# in `libexec/project-launcher`, which ships inside the release and is therefore
# always the version that deployed the project it is launching.
#
# Exit codes: 2 invalid input, 3 missing prerequisite, 4 missing runtime
# prerequisite. Anything else is the release launcher's, passed through by exec.

set -euo pipefail

readonly STATE_ROOT="/etc/agentic-postgres/projects"
readonly RELEASE_ROOT="/opt/agentic-postgres/releases"

# The one path this file and every release must agree on. It is the interface,
# and it is deliberately a single fixed name rather than a per-action mapping:
# a mapping is a fact about a release, and this file may not hold one.
readonly RELEASE_LAUNCHER="libexec/project-launcher"

# Same shape as schemas/outputs.schema.json's projectKey: a slug of at least 3
# characters, a hyphen, and an environment of at least 2.
readonly PROJECT_KEY_PATTERN='^[a-z][a-z0-9-]{4,47}$'

die() {
  local code="$1"
  shift
  printf 'agentic-postgres-project: %s\n' "$*" >&2
  exit "$code"
}

usage() {
  cat <<'USAGE'
Usage: /usr/local/libexec/agentic-postgres/project <project-key> <action>

Actions: materialize | up | down | attach | detach | status

Resolves the installed release recorded in that project's deployed outputs
document and executes that release's own launcher. Not intended for direct
operator use; systemd invokes it through
agentic-postgres-project@<project-key>.service.
USAGE
}

main() {
  case "${1-}" in
    --help|-h) usage; return 0 ;;
    "") usage >&2; die 2 "a project key is required." ;;
  esac

  local project_key="$1"

  # Validated before it becomes a path component. This is the check that makes
  # the systemd instance name safe.
  if ! printf '%s' "${project_key}" | grep -Eq "${PROJECT_KEY_PATTERN}"; then
    die 2 "not a valid project key: ${project_key}"
  fi

  # The action is passed through unexamined. Which actions exist is a property
  # of a release, and a list here would be a second definition of it -- the
  # kind that agrees right up until a release adds one.
  [ "$#" -ge 2 ] || { usage >&2; die 2 "an action is required."; }

  [ "$(id -u)" -eq 0 ] || die 3 "must run as root."
  command -v jq >/dev/null 2>&1 || die 3 "jq is not installed."

  local deployment="${STATE_ROOT}/${project_key}/outputs.json"
  [ -f "${deployment}" ] || die 4 "no deployment state for ${project_key}: ${deployment}"
  [ -L "${deployment}" ] && die 2 "${deployment} is a symlink, which is not accepted."

  local commit release
  commit="$(jq -r '.source_commit // empty' "${deployment}")"
  [ -n "${commit}" ] || die 4 "${deployment} records no source commit."
  case "${commit}" in
    *[!0-9a-f]* | "") die 2 "recorded release commit is not hexadecimal: ${commit}" ;;
  esac
  [ "${#commit}" -eq 40 ] || die 2 "recorded release commit is not 40 characters: ${commit}"

  release="${RELEASE_ROOT}/${commit}"
  [ -d "${release}" ] || die 4 "installed release is missing: ${release}"
  [ -L "${release}" ] && die 2 "installed release path is a symlink: ${release}"

  local owner
  owner="$(stat -c '%U' "${release}")"
  [ "${owner}" = "root" ] || die 2 "installed release is owned by ${owner}, expected root."

  local launcher="${release}/${RELEASE_LAUNCHER}"
  # Named rather than guessed at: a release that predates ADR 0037 has its
  # launcher logic in the installed copy of this file, which no longer holds
  # any. Saying so is the whole point -- the alternative is falling back to
  # whatever this file happens to know, which is how a Session 3 project got
  # started as a Session 2 one.
  [ -f "${launcher}" ] \
    || die 4 "release ${commit} carries no ${RELEASE_LAUNCHER}; it predates ADR 0037. Redeploy ${project_key}."
  [ -L "${launcher}" ] && die 2 "${launcher} is a symlink, which is not accepted."
  [ -x "${launcher}" ] || die 4 "${launcher} is not executable."

  exec "${launcher}" "$@"
}

main "$@"
