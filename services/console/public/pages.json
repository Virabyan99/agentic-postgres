{
  "views": [
    {
      "id": "accept",
      "path": "/accept",
      "ledger": ["accounts", "organizations"],
      "calls": [
        "GET /v1/me",
        "POST /v1/invitations/accept",
        "POST /v1/sessions",
        "POST /v1/sessions/refresh",
        "POST /v1/me/totp",
        "POST /v1/me/totp/confirm"
      ]
    },
    {
      "id": "sign-in",
      "path": "/console/#/sign-in",
      "ledger": ["accounts"],
      "calls": ["POST /v1/sessions", "POST /v1/sessions/refresh", "DELETE /v1/sessions/current"]
    },
    {
      "id": "overview",
      "path": "/console/#/",
      "ledger": ["accounts", "organizations", "projects_self_service", "management_api"],
      "calls": [
        "GET /v1/me",
        "GET /v1/organizations",
        "GET /v1/projects",
        "GET /v1/operations",
        "POST /v1/me/totp",
        "POST /v1/me/totp/confirm",
        "GET /v1/organizations/{organization}/plan",
        "GET /v1/organizations/{organization}/usage"
      ]
    },
    {
      "id": "new-organization",
      "path": "/console/#/new",
      "ledger": ["organizations"],
      "calls": ["POST /v1/organizations"]
    },
    {
      "id": "organization",
      "path": "/console/#/org/{organization}",
      "ledger": ["accounts", "organizations", "projects_self_service", "management_api"],
      "calls": [
        "GET /v1/organizations",
        "GET /v1/projects",
        "GET /v1/operations",
        "GET /v1/organizations/{organization}/plan",
        "GET /v1/organizations/{organization}/usage"
      ]
    },
    {
      "id": "activity",
      "path": "/console/#/org/{organization}/activity",
      "ledger": ["projects_self_service"],
      "calls": ["GET /v1/operations"]
    },
    {
      "id": "operation",
      "path": "/console/#/operations/{operation}",
      "ledger": ["projects_self_service"],
      "calls": [
        "GET /v1/operations/{operation}",
        "GET /v1/organizations",
        "GET /v1/projects",
        "GET /v1/projects/{key}"
      ]
    },
    {
      "id": "new-project",
      "path": "/console/#/org/{organization}/new-project",
      "ledger": ["projects_self_service"],
      "calls": [
        "POST /v1/projects",
        "GET /v1/operations/{operation}",
        "GET /v1/organizations/{organization}/plan",
        "GET /v1/operations"
      ]
    },
    {
      "id": "project-overview",
      "path": "/console/#/projects/{key}",
      "ledger": ["accounts", "organizations", "projects_self_service", "management_api"],
      "calls": ["GET /v1/projects/{key}"]
    },
    {
      "id": "connect",
      "path": "/console/#/projects/{key}/connect",
      "ledger": ["pooled_endpoint", "direct_endpoint", "postgresql"],
      "calls": [
        "GET /v1/projects/{key}/connections",
        "POST /v1/projects/{key}/credentials",
        "GET /v1/operations/{operation}"
      ]
    },
    {
      "id": "sql-editor",
      "path": "/console/#/projects/{key}/sql",
      "ledger": ["sql_editor", "pooled_endpoint", "direct_endpoint"],
      "calls": [
        "GET /v1/projects/{key}",
        "GET /v1/projects/{key}/connections"
      ]
    },
    {
      "id": "branches",
      "path": "/console/#/projects/{key}/branches",
      "ledger": ["branches", "restore_to_branch"],
      "calls": [
        "GET /v1/projects/{key}/branches",
        "POST /v1/projects/{key}/branches",
        "POST /v1/projects/{key}/restores",
        "POST /v1/projects/{key}/branches/{branch}/reset",
        "DELETE /v1/projects/{key}/branches/{branch}",
        "GET /v1/operations/{operation}",
        "GET /v1/organizations/{organization}/plan"
      ]
    },
    {
      "id": "backups",
      "path": "/console/#/projects/{key}/backups",
      "ledger": ["backups_and_pitr"],
      "calls": ["GET /v1/projects/{key}/backups"]
    },
    {
      "id": "project-usage",
      "path": "/console/#/projects/{key}/usage",
      "ledger": ["usage"],
      "calls": ["GET /v1/projects/{key}/usage"]
    },
    {
      "id": "insights",
      "path": "/console/#/projects/{key}/insights",
      "ledger": ["query_insights"],
      "calls": ["GET /v1/projects/{key}/insights"]
    },
    {
      "id": "monitoring",
      "path": "/console/#/projects/{key}/monitoring",
      "ledger": ["monitoring"],
      "calls": ["GET /v1/projects/{key}/monitoring"]
    },
    {
      "id": "project-settings",
      "path": "/console/#/projects/{key}/settings",
      "ledger": ["idle_sleep", "compute_profiles", "sleep", "export", "project_deletion", "region", "support_bundle"],
      "calls": [
        "GET /v1/projects/{key}",
        "PUT /v1/projects/{key}/idle-sleep",
        "PUT /v1/projects/{key}/compute",
        "POST /v1/projects/{key}/sleep",
        "POST /v1/projects/{key}/wake",
        "POST /v1/projects/{key}/export",
        "DELETE /v1/projects/{key}",
        "GET /v1/operations/{operation}",
        "GET /v1/projects/{key}/diagnostics"
      ]
    },
    {
      "id": "plan",
      "path": "/console/#/org/{organization}/plan",
      "ledger": ["plan_free", "plan_premium"],
      "calls": [
        "GET /v1/plans",
        "GET /v1/organizations/{organization}/plan",
        "POST /v1/organizations/{organization}/plan-interest"
      ]
    },
    {
      "id": "organization-usage",
      "path": "/console/#/org/{organization}/usage",
      "ledger": ["usage"],
      "calls": ["GET /v1/organizations/{organization}/usage"]
    },
    {
      "id": "notifications",
      "path": "/console/#/org/{organization}/notifications",
      "ledger": ["notifications"],
      "calls": ["GET /v1/organizations/{organization}/notifications"]
    },
    {
      "id": "organization-settings",
      "path": "/console/#/org/{organization}/settings",
      "ledger": ["organizations", "api_keys", "accounts"],
      "calls": [
        "GET /v1/organizations/{organization}/members",
        "PATCH /v1/organizations/{organization}/members/{user}",
        "DELETE /v1/organizations/{organization}/members/{user}",
        "POST /v1/invitations",
        "GET /v1/organizations/{organization}/invitations",
        "DELETE /v1/organizations/{organization}/invitations/{invitation}",
        "GET /v1/organizations/{organization}/keys",
        "POST /v1/organizations/{organization}/keys",
        "DELETE /v1/organizations/{organization}/keys/{key_id}"
      ]
    },
    {
      "id": "help",
      "path": "/console/#/help",
      "ledger": ["support_bundle", "console"],
      "calls": []
    }
  ]
}
